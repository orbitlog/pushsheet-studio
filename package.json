{
  "name": "pushsheet-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:examples": "vitest run tests/real-files.test.ts",
    "format": "prettier --write src tests docs README.md package.json tsconfig.json vite.config.ts index.html"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "@lucide/vue": "^1.79.0",
    "papaparse": "^5.5.3",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "@types/papaparse": "^5.3.16",
    "@vitejs/plugin-vue": "^5.2.4",
    "jsdom": "^26.1.0",
    "typescript": "~5.7.3",
    "prettier": "^3.6.2",
    "vite": "^6.4.1",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  }
}
